# Normalize new source/text across Windows and macOS.
* text=auto eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.zip binary
*.pdf binary
*.docx binary
*.png binary
*.jpg binary

# Reviewed snapshots are byte-preserved: hashes are part of the contract.
/fullkit/contract/** -text
/references/** -text
/README.md -text
/Validation.md -text
/Full-Kit-1.00.1-build-artifact.zip binary
/reports/Source-Copy-Register.json -text
