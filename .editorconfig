root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,toml,yml,yaml}]
indent_size = 2

# Preserved reviewed material must not be reformatted automatically.
[fullkit/contract/**]
insert_final_newline = unset
end_of_line = unset
charset = unset

[references/**]
insert_final_newline = unset
end_of_line = unset
charset = unset
